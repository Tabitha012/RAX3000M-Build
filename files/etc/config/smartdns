config smartdns
    option enabled '1'
    option port '6053'
    option tcp_server '1'
    option cache_size '4096'
    option prefetch_domain '1'
    option serve_expired '1'
    option dualstack_ip_selection '1'
    option speed_check_mode 'ping,tcp:80,tcp:443'
    option response_mode 'fastest-ip'
    option force_aaaa_soa '1'

config server
    option name 'AliDNS'
    option ip '223.5.5.5'

config server
    option name 'TencentDNS'
    option ip '119.29.29.29'

config server
    option name 'Cloudflare'
    option ip '1.1.1.1'

config server
    option name 'Google'
    option ip '8.8.8.8'
